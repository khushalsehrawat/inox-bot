# Existing Express API origin; never include credentials here.
INOX_API_ORIGIN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SQLite development/rollback data directory; MySQL mode stores upload bytes in web_media_content.
# SQLite development defaults to <project>/data/web-catalogue.
WEB_CATALOGUE_DATA_DIR=
# Optional independent website administrator. Set all three together.
# WEB_ADMIN_PASSWORD_HASH uses scrypt:salt:hash; never set a plaintext password here.
# Use a random session secret of at least 32 characters. Server-only variables.
WEB_ADMIN_EMAIL=
WEB_ADMIN_PASSWORD_HASH=
WEB_ADMIN_SESSION_SECRET=

# Runtime catalogue. SQLite is a development fallback only; production requires mysql.
# If omitted, configured WEB_MYSQL_* values select MySQL automatically.
# Use sqlite explicitly only for an isolated local catalogue, never for the live site.
WEB_DATABASE_DRIVER=mysql
WEB_MYSQL_HOST=
WEB_MYSQL_PORT=3306
WEB_MYSQL_DATABASE=u439578485_inox
# Dedicated website account, restricted to the audited web_ tables only.
WEB_MYSQL_USER=
WEB_MYSQL_PASSWORD=
# Absolute CA bundle path for verified TLS when connecting remotely.
WEB_MYSQL_SSL_CA=
# Required for import previews when WEB_ADMIN_SESSION_SECRET is not set.
WEB_IMPORT_SECRET=

# Main-site enquiry notifications via Google Workspace (server-only).
# Use the full Google mailbox address and a Google app password, not its login password.
# If info@ is an alias/group, authenticate with the real Google mailbox that sends mail.
ENQUIRY_SMTP_USER=info@inoxdecor.com
ENQUIRY_SMTP_APP_PASSWORD=
ENQUIRY_NOTIFY_TO=info@inoxdecor.com

# Ask INOX: disabled until enabled. Runtime server flag; no public API credentials.
# Gemini is the default live provider on the main site.
ASK_INOX_ENABLED=true
ASK_INOX_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
ASK_INOX_GEMINI_LIVE_MODEL=gemini-3.8-live
ASK_INOX_GEMINI_TEXT_MODEL=gemini-2.5-flash
ASK_INOX_REALTIME_MODEL=gpt-realtime-2.1
ASK_INOX_TEXT_MODEL=gpt-4.1-mini
ASK_INOX_VOICE_SECONDS=300
# Enable only behind a trusted proxy that REPLACES client x-forwarded-for headers.
ASK_INOX_TRUST_PROXY=false
# Optional Python executable for repeatable PDF extraction (requires pypdf).
ASK_INOX_PYTHON=python
